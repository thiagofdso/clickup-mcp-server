# ClickUp MCP Server environment example
#
# Copy this file to .env and adjust as needed.

# Global ClickUp credentials (API key optional when HEADER_AUTHENTICATION=true)
CLICKUP_API_KEY=
CLICKUP_TEAM_ID=

# Per-request authentication toggle
HEADER_AUTHENTICATION=false

# Optional HTTP/HTTPS proxy for ClickUp API traffic
PROXY_AUTHENTICATION=

# Transport configuration
ENABLE_SSE=false
ENABLE_STDIO=true
PORT=3231

# Logging configuration
LOG_LEVEL=ERROR

